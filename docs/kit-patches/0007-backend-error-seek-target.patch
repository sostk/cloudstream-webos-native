From 35f31e4b9361181a2a37b8eb9de6aab9f8da3d49 Mon Sep 17 00:00:00 2001
From: sostk <poudelswastik@gmail.com>
Date: Sat, 24 Oct 2026 22:25:49 +1100
Subject: [PATCH 2/3] Fail playback when the backend reports an error

Starfish reports a stream it cannot play with event 18 ("Resource
Allocation Error" 601, "Playing error" 100). The backend already turned
it into BackendEvent::Error, but the controller ignored it: on the same
webOS 4.4.3 log every Load after the stuck one returned after 20 s with
601, and the controller still went Ready -> Playing, leaving the app's
controls over a black picture with no way to tell.

- media/src/controller.cpp: BackendEvent::Error queues a Fail command;
  the playback thread fails with the backend's reason (unloading the
  decoder) unless already idle, failed or stopped, so a repeated event
  fails once. An event during a Load that blocks lands once it returns.
- media/include/wnk/media/controller.hpp: the state diagram says so.
- tests/unit/test_media.cpp: an error event ends in Error with the reason
  and one unload; a repeated event gives one Error.

Verified with host tests (test_media 41/41).
---
 media/include/wnk/media/controller.hpp |  1 +
 media/src/controller.cpp               | 15 ++++++++++++--
 tests/unit/test_media.cpp              | 27 ++++++++++++++++++++++++++
 3 files changed, 41 insertions(+), 2 deletions(-)

diff --git a/media/include/wnk/media/controller.hpp b/media/include/wnk/media/controller.hpp
index c71cc71..414824c 100644
--- a/media/include/wnk/media/controller.hpp
+++ b/media/include/wnk/media/controller.hpp
@@ -6,6 +6,7 @@
 //                  │          │              │  │
 //                  │          └─seek─► Seeking ┘  └─(source ends, buffer drained)─► Ended
 //                  └──────────────(any failure)──────────────────────────────────► Error
+//                                 (a BackendEvent::Error too: the decoder refused the stream)
 //   any state ─stop─► Stopped
 //
 // A reader thread reads packets into one lane per stream (video, audio), up to max_queue_us ahead;
diff --git a/media/src/controller.cpp b/media/src/controller.cpp
index 08dff2e..52711d7 100644
--- a/media/src/controller.cpp
+++ b/media/src/controller.cpp
@@ -68,10 +68,10 @@ struct PlaybackController::Core {
     PlayState state() const;
     const char *backend_name() const { return backend_->name(); }  // may change at open (AutoBackend)
 
-    enum class Cmd : uint8_t { Open, Play, Pause, Seek, Stop, Audio };
+    enum class Cmd : uint8_t { Open, Play, Pause, Seek, Stop, Audio, Fail };
     struct Command {
         Cmd cmd;
-        std::string uri;
+        std::string uri;     // Fail: the backend's reason
         int64_t pts_us = 0;  // Audio: the track
         bool release = false;  // Pause: unload the decoder even if the backend can pause
     };
@@ -393,6 +393,10 @@ void PlaybackController::Core::on_backend_event(BackendEvent e, const std::strin
     } else if (e == BackendEvent::ResourceLost) {
         // Treat like a pause: the decoder must be loaded again before more packets go in.
         post({Cmd::Pause, {}, 0, true});
+    } else if (e == BackendEvent::Error) {
+        // The decoder refused the stream (Starfish: no decoder resource after a 20 s Load). Carrying
+        // on would show the controls over a black picture for good.
+        post({Cmd::Fail, detail.empty() ? std::string("backend error") : detail, 0});
     }
 }
 
@@ -481,6 +485,13 @@ bool PlaybackController::Core::apply(const Command &c) {
             set_state(PlayState::Stopped);
             return false;
         case Cmd::Audio: do_audio(static_cast<int>(c.pts_us)); break;
+        case Cmd::Fail: {
